{
  "info": {
    "_postman_id": "aula7-jwt-synapseshop",
    "name": "SynapseShop - Aula 7 - JWT e Segurança",
    "description": "Coleção da Aula 7 com autenticação JWT, papéis de acesso, throttling, paginação, filtros, busca, ordenação e cenários de erro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Login - Admin - Sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          }
        },
        {
          "name": "Login - User - Sucesso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user\",\n  \"password\": \"User123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          }
        },
        {
          "name": "Login - Senha Incorreta - 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"SenhaErrada123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                "refresh",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Itens",
      "item": [
        {
          "name": "Listar Itens - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ]
            }
          }
        },
        {
          "name": "Paginação - Página 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Busca - Notebook",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/?search=Notebook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Notebook"
                }
              ]
            }
          }
        },
        {
          "name": "Ordenação - Preço",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/?ordering=price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ],
              "query": [
                {
                  "key": "ordering",
                  "value": "price"
                }
              ]
            }
          }
        },
        {
          "name": "Filtro - Categoria 1",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/items/?category=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ],
              "query": [
                {
                  "key": "category",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Controle de Acesso",
      "item": [
        {
          "name": "Sem Token - 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/items/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ]
            }
          }
        },
        {
          "name": "User - Acesso Negado - 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "Executar utilizando o access token do usuário comum.",
            "url": {
              "raw": "{{base_url}}/api/v1/items/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 - Throttling",
      "item": [
        {
          "name": "Endpoint protegido - Teste de limite",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "description": "Repetir a requisição até atingir o limite configurado de 30 requisições por minuto para usuários autenticados.",
            "url": {
              "raw": "{{base_url}}/api/v1/items/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                ""
              ]
            }
          }
        }
      ]
    }
  ]
}