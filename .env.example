# Copie para .env na sua maquina e preencha os valores reais localmente.
# Nunca coloque chaves ou tokens reais no GitHub.

SECRET_KEY=

LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=replace-with-supported-model

# Timeout por tentativa: no maximo 5 segundos.
LLM_TIMEOUT_SECONDS=5

# Numero maximo de tentativas HTTP, incluindo a inicial.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.2

# Circuit breaker.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30

# Custo por mil tokens, em USD. Preencher conforme o provedor/modelo.
LLM_COST_INPUT_PER_1K_TOKENS=0
LLM_COST_OUTPUT_PER_1K_TOKENS=0

# Limite para proteger o envio de logs muito grandes.
LLM_MAX_INPUT_CHARS=12000

# PostgreSQL - desenvolvimento local
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
DB_SSLMODE=require

# Pool de conexoes SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5

# Metricas de desempenho (Aula 20)
API_METRICS_REDIS_KEY=synapseshop:observability:requests
API_METRICS_RETENTION_SECONDS=604800
API_CACHE_METRICS_REDIS_KEY=synapseshop:observability:cache
API_MESSAGING_METRICS_REDIS_KEY=synapseshop:observability:messaging

# Consulta em linguagem natural (Aula 21)
ASK_SQL_MAX_ROWS=200
ASK_SQL_STATEMENT_TIMEOUT_MS=5000
API_BASE_URL=http://api:8000
# Opcional: token JWT de acesso para o painel. Se vazio, use o login no painel.
ASK_SQL_API_TOKEN=

# Embeddings para RAG (Aula 24)
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# Se vazio, usa LLM_API_KEY como fallback.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=replace-with-supported-embedding-model
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_BASE_SECONDS=0.2
EMBEDDING_BATCH_SIZE=32

# Indice RAG (Aula 24)
# Vazio usa app/data/rag_index.sqlite3 localmente; o Compose usa /data/rag_index.sqlite3.
RAG_INDEX_PATH=
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=80