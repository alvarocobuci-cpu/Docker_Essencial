# Copie para .env na sua maquina e preencha os valores reais localmente.
# Nunca coloque chaves ou tokens reais no GitHub.

LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=replace-with-supported-model

# Timeout por tentativa: no maximo 5 segundos.
LLM_TIMEOUT_SECONDS=5

# Numero maximo de tentativas HTTP, incluindo a inicial.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.2

# Circuit breaker.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30

# Custo por mil tokens, em USD. Preencher conforme o provedor/modelo.
LLM_COST_INPUT_PER_1K_TOKENS=0
LLM_COST_OUTPUT_PER_1K_TOKENS=0

# Limite para proteger o envio de logs muito grandes.
LLM_MAX_INPUT_CHARS=12000

# PostgreSQL - desenvolvimento local
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
DB_SSLMODE=require

# Pool de conexoes SQLAlchemy
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5