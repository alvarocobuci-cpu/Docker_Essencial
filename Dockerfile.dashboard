
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-dashboard.txt ./requirements-dashboard.txt

RUN pip install --no-cache-dir -r requirements-dashboard.txt

COPY app/ ./app/

RUN useradd --create-home --shell /usr/sbin/nologin dashboard \
    && chown -R dashboard:dashboard /app

USER dashboard

EXPOSE 8501

CMD ["streamlit", "run", "app/dashboard/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
